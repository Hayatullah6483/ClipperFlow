rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint for UserPreference
    function isValidUserPreference(data) {
      return data.keys().hasAll(['uid', 'defaultClipCount', 'defaultProcessingMode', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'defaultClipCount', 'defaultProcessingMode', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && data.defaultClipCount is int
        && data.defaultClipCount >= 1
        && data.defaultClipCount <= 20
        && data.defaultProcessingMode is string
        && data.defaultProcessingMode.size() <= 32
        && data.defaultProcessingMode in ['accurate-reencode', 'stream-copy']
        && data.updatedAt is string
        && data.updatedAt.size() <= 64;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserPreference(incoming());
      allow update: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserPreference(incoming()) && (
        incoming().uid == existing().uid &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'defaultClipCount', 'defaultProcessingMode', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }
  }
}
